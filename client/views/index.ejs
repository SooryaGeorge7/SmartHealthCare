<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Healthcare Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Healthcare Monitoring Dashboard</h1>

    <!-- Patient ID Input -->
    <form action="/" method="GET">
        <label for="patientid">Enter Patient ID:</label>
        <input type="text" name="patientid" id="patientid" pattern="[a-zA-Z0-9]{1,5}" 
        maxlength="5" required value="<%= patientid || '' %>">
        <button type="submit">Fetch Patient's Health Information</button>
    </form>

    <!-- Vitals -->
    <% if (vitals) { %>
        <h2>Patient Vitals:</h2>
        <p><strong>Heart Rate:</strong> <%= vitals.heartrate %> bpm</p>
        <p><strong>Oxygen Level:</strong> <%= vitals.oxygenlevel %> %</p>
        <p><strong>Temperature:</strong> <%= vitals.temperature %> °C</p>
    <% } else if (errorMessage && !vitals) { %>
        <p class="error">No vitals data available for this patient.</p>
    <% } %>

    <!--Heart Rate Summary -->
    <% if (summary && vitals) { %>
        <h2>Heart Rate Summary:</h2>
        <p><strong>Current Average Heart Rate:</strong> <%= summary.averageheartrate %> bpm</p>
        <p><strong>Risk Level:</strong> <%= summary.risklevel %></p>
        <p><strong>Recommendation:</strong> <%= summary.recommendation %></p>
    <% } else if (errorMessage && !vitals) { %>
        <p class="error">No heart rate summary available.</p>
    <% } %>

    <!--Lab Test Results -->
    <% if (result  && result.length > 0) { %>
        <h2>Lab Test Results:</h2>
        <ul>
            <% result.forEach(function(labtest) { %>
                <li><strong><%= labtest.testname %>:</strong> <%= labtest.result %></li>
            <% }) %>
        </ul>
    <% } else if (errorMessage && result.length===0) { %>
        <p class="error">No lab test results found for this patient.</p>
    <% } %>

    <!-- Consultation Chat -->
    <h2>Consultation Chat</h2>
    <div id="chat">
        <% if (chatMessages.length > 0) { %>
            <% chatMessages.forEach(function(chat) { %>
                <p><strong><%= chat.sender %>:</strong> <%= chat.message %></p>
            <% }) %>
        <% } else { %>
            <p>No messages yet.</p>
        <% } %>
    </div>

    <!--  chat message box -->
    <h3>Send a Chat Message:</h3>
    <form action="/send-chat" method="POST">
        <input type="hidden" name="patientid" value="<%= patientid %>">
        <label for="message">Message:</label>
        <input type="text" name="message" id="message" required>
        <button type="submit">Send</button>
    </form>

</body>
</html>
